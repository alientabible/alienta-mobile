# Estas variables se incluyen en la aplicación cliente y no son secretos.
# Nunca uses aquí la clave service_role de Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Opcional para una URL web estable. Si se deja vacío, Expo genera la URL
# correcta para web, Expo Go o el esquema alienta:// de una compilación.
EXPO_PUBLIC_AUTH_REDIRECT_URL=
